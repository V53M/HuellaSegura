DATABASE_URL=postgres://huellasegura:huellasegura_local@localhost:5433/huellasegura
PORT=3000
# Secreto que Traccar envía en X-Traccar-Secret (forward.header)
TRACCAR_SECRET=cambiar-por-un-secreto-largo
# Cada cuántos segundos el motor revisa umbrales, excepciones vencidas, escaladas y pérdida de señal
TICK_SEGUNDOS=15
# Correo de contacto que Nominatim/OpenStreetMap pide a quien usa su geocodificador (opcional)
GEOCODIFICACION_CONTACTO=
# Ruta al JSON de la cuenta de servicio de Firebase (Configuración del proyecto → Cuentas de servicio).
# Sin ella, las push al adoptante se registran en `notificacion` con error FCM_NO_CONFIGURADO y no se envían.
FCM_CREDENCIALES=
# Versión de la política de datos que se pide aceptar (Ley 1581). Al cambiar el texto, cambiar la versión.
POLITICA_VERSION=2027-01-borrador
# 1 en producción con HTTPS: la cookie de sesión solo viaja cifrada
COOKIE_SEGURA=0
# 1 si la API está detrás de Nginx u otro proxy (para registrar la IP real en sesiones y consentimientos)
DETRAS_DE_PROXY=0
